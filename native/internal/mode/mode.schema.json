{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openkakutou/game/blob/main/native/internal/mode/mode.schema.json",
  "title": "OpenKakutou game mode",
  "description": "A game mode: a flow of built-in screens and the match rules (roadmap decision 030). Written as JSONC. See docs/modes.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "name", "flow", "rules"],
  "$defs": {
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Only these names. Absent: every name; empty: none."
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Not these names, whatever include says."
        }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier, e.g. versus."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Name shown in the main menu."
    },
    "flow": {
      "type": "array",
      "minItems": 1,
      "description": "Built-in screens in the order they run; must include a match screen.",
      "contains": {
        "type": "object",
        "properties": { "screen": { "const": "match" } },
        "required": ["screen"]
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["screen"],
        "properties": {
          "screen": {
            "enum": [
              "characterSelect",
              "stageSelect",
              "matchSetup",
              "versus",
              "match",
              "results",
              "continue",
              "victory"
            ]
          },
          "params": { "type": "object" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "screen": { "const": "characterSelect" } }
            },
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sides": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "enum": ["p1", "p2"] }
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "params": { "type": "object", "maxProperties": 0 }
              }
            }
          }
        ]
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sides",
        "rounds",
        "timeLimitSeconds",
        "opponents",
        "onWin",
        "onLose"
      ],
      "properties": {
        "sides": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["control", "characters"],
            "properties": {
              "control": { "enum": ["human", "cpu", "humanOrCpu"] },
              "characters": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "rounds": {
          "type": "integer",
          "minimum": 1,
          "not": { "multipleOf": 2 },
          "description": "Best of N; odd."
        },
        "timeLimitSeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "0: no time limit."
        },
        "opponents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["chosen", "ladder"] },
            "count": { "type": "integer", "minimum": 1 },
            "final": {
              "type": "string",
              "minLength": 1,
              "description": "Folder name of the character fought after the count ladder opponents (a boss). Ladder only; a name that is not installed is skipped."
            }
          },
          "if": { "properties": { "kind": { "const": "ladder" } } },
          "then": { "required": ["count"] },
          "else": { "not": { "anyOf": [{ "required": ["count"] }, { "required": ["final"] }] } }
        },
        "onWin": {
          "enum": ["results", "nextOpponent", "continue", "gameOver"]
        },
        "onLose": {
          "enum": ["results", "nextOpponent", "continue", "gameOver"]
        },
        "roster": {
          "type": "object",
          "additionalProperties": false,
          "description": "Which characters and stages the mode shows. Names are folder or file names, matched ignoring case.",
          "properties": {
            "characters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "select": { "$ref": "#/$defs/filter", "description": "What the character select screens show." },
                "opponents": { "$ref": "#/$defs/filter", "description": "The pool a CPU opponent can come from." }
              }
            },
            "stages": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "select": { "$ref": "#/$defs/filter", "description": "What the stage select screens show." }
              }
            }
          }
        }
      }
    }
  }
}
